#!/bin/bash
# flashMLA dense decode tileop test cases

# Default dense MLA shape from the tileop model:
#   Q:  [Sq * QHeadPerHK, Dk]
#   KV: [NumBlocks * PageBlockSize, Dk]
#   O:  [Sq * QHeadPerHK, Dv]
make TESTCASE=flashMLA Sq=64 QHeadPerHK=1 NumBlocks=2 MaxBlocksPerSeq=2 Dk=512 Dv=512 DChunk=128 VChunk=128 Tm=16 Tk=16

# Smaller sequence smoke test.
make TESTCASE=flashMLA Sq=32 QHeadPerHK=1 NumBlocks=1 MaxBlocksPerSeq=1 Dk=512 Dv=512 DChunk=128 VChunk=128 Tm=16 Tk=16
