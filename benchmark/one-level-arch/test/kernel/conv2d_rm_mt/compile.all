#!/bin/bash
# Conv2d 1x1 RowMajor multi-thread (batch-of-4) operator, modeled on
# matmul_multithread.hpp.
#
# gM (= in_h*in_w) must be divisible by tM; gN (= out_c) by tN; gK (= in_c) by tK.
# Tile byte limits: each PE A tile [tM, tK] and C tile [tM, tN], shared B tile
# [tK, tN] must each be smaller than 8 KB.
#
# gfrun SIMT limitation (see docs/conv2d_accuracy_verification.md §13.4):
# keep Mb*Nb*Kb < ~64 to avoid the scalar-register TSTORE address issue.

: "${COMPILER_DIR:?Set COMPILER_DIR to the Linx compiler bin directory}"

# FP32 — small (4x4, K=16, single Kb, single Mb)
make diss TESTCASE=conv2d_rm_mt \
    COMPILER_DIR="$COMPILER_DIR" \
    TYPE=FP32 IN_H=4 IN_W=4 IN_C=16 OUT_C=16 \
    tilM=16 tilN=16 tilK=16

# FP32 — K=64 (four Kb, exercises TMATMUL_ACC)
make diss TESTCASE=conv2d_rm_mt \
    COMPILER_DIR="$COMPILER_DIR" \
    TYPE=FP32 IN_H=4 IN_W=4 IN_C=64 OUT_C=16 \
    tilM=16 tilN=16 tilK=16

# FP32 — multiple N blocks (Mb=1, Nb=4, Kb=4)
make diss TESTCASE=conv2d_rm_mt \
    COMPILER_DIR="$COMPILER_DIR" \
    TYPE=FP32 IN_H=4 IN_W=4 IN_C=64 OUT_C=64 \
    tilM=16 tilN=16 tilK=16

# FP32 — multiple M blocks (Mb=4, Nb=1, Kb=1)
make diss TESTCASE=conv2d_rm_mt \
    COMPILER_DIR="$COMPILER_DIR" \
    TYPE=FP32 IN_H=4 IN_W=16 IN_C=16 OUT_C=16 \
    tilM=16 tilN=16 tilK=16

# FP32 — multiple M and N blocks with Kb=2 (Mb=4, Nb=4, Kb=2)
make diss TESTCASE=conv2d_rm_mt \
    COMPILER_DIR="$COMPILER_DIR" \
    TYPE=FP32 IN_H=8 IN_W=8 IN_C=32 OUT_C=64 \
    tilM=16 tilN=16 tilK=16

# FP16 — small (4x4, K=16)
make diss TESTCASE=conv2d_rm_mt \
    COMPILER_DIR="$COMPILER_DIR" \
    TYPE=FP16 IN_H=4 IN_W=4 IN_C=16 OUT_C=16 \
    tilM=16 tilN=16 tilK=16

# FP16 — K=64
make diss TESTCASE=conv2d_rm_mt \
    COMPILER_DIR="$COMPILER_DIR" \
    TYPE=FP16 IN_H=4 IN_W=4 IN_C=64 OUT_C=16 \
    tilM=16 tilN=16 tilK=16
