#!/bin/bash
# Multi-thread GMMA matmul operator.

: "${COMPILER_DIR:?Set COMPILER_DIR to the Linx compiler bin directory}"

# Build the baseline SharedTile kernel and the variant that reuses Shared B
# across all M blocks in the same N block.
make TESTCASE=matmul_shared \
    COMPILER_DIR="$COMPILER_DIR" \
    B=1 M=256 N=256 K=256 \
    tM=32 tN=32 tK=32

make TESTCASE=matmul_reuseB \
    COMPILER_DIR="$COMPILER_DIR" \
    B=1 M=256 N=256 K=256 \
    tM=32 tN=32 tK=32
